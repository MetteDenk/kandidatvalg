# ---------------------------------------------------------------------------
# Psykologkompasset - miljøvariabler. Kopiér til .env og udfyld.
# ---------------------------------------------------------------------------

# Database. Lokalt: "docker compose up -d db". Produktion: URL fra Coolifys Postgres-ressource.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/psykologkompasset"

# Adressen, siden kører på (bruges i login-mails og links). Produktion: https://www.psykologkompasset.dk
APP_URL="http://localhost:3100"

# Mistral (EU). Skriver stikord om til tekst. Kaldes KUN server-side.
# Uden nøgle vises kandidatens stikord uændret.
MISTRAL_API_KEY=""

# E-mail. Uden SMTP logges mails til konsollen. Produktion: en EU-udbyder.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Psykologkompasset <noreply@psykologkompasset.dk>"

